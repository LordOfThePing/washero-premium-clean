% Edge function secrets for self-hosted edge-runtime (edge-runtime/.env.functions).
% Copy from here:  cp selfhost/edge-runtime/.env.functions.example selfhost/edge-runtime/.env.functions
% Values here are loaded into the edge-runtime container by compose (env_file, optional).
% NEVER commit real values. These mirror the hosted 'supabase secrets set' list;
% see supabase/functions/.env.example for full docs of each key.

# Core (available to functions via Deno.env.get) — override to reach the tunnel host.
SUPABASE_URL=https://api.washero.ar
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Botmaker
BOTMAKER_WEBHOOK_SECRET=
BOTMAKER_BOOKING_TOOLS_SECRET=
BOTMAKER_API_TOKEN=
BOTMAKER_BASE_URL=
BOTMAKER_SEND_PATH=
BOTMAKER_CHANNEL_ID=
BOTMAKER_TEMPLATE_SEND_MODE=
BOTMAKER_TEMPLATE_SEND_PATH=
BOTMAKER_TEMPLATE_BASE_URL=
BOTMAKER_CHAT_CHANNEL_NUMBER=
BOTMAKER_WA_TEMPLATE_BANK_TRANSFER_INFO=
BOTMAKER_CONFIGURED_TEMPLATES=
WASHI_AGENT_SECRET=
PUSH_INTERNAL_SECRET=
BOTMAKER_TOOLS_SECRET=

# WhatsApp n8n gateway (outbound)
N8N_WHATSAPP_WEBHOOK_URL=
N8N_WHATSAPP_WEBHOOK_SECRET=
N8N_WHATSAPP_WEBHOOK_HEADER=x-washero-outbound-secret
WASHERO_TRANSPORT=cloud_api

# Google
GOOGLE_MAPS_SERVER_KEY=

# MercadoPago
MERCADOPAGO_ACCESS_TOKEN=

# Web push
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=

# Site / misc
PUBLIC_SITE_URL=https://washero.ar
OPERATOR_ALLOW_UNASSIGNED_TODAY=
WASHERO_SKIP_PAYMENT=

# WhatsApp agent (Claude path is DISABLED per docs — leave ANTHROPIC unset)
ANTHROPIC_API_KEY=
WHATSAPP_AGENT_MODE=
WHATSAPP_AGENT_TEST_PHONES=
WHATSAPP_AGENT_WORKER_SECRET=
WHATSAPP_AGENT_DIAGNOSTICS_ALLOW_ANY_PHONE=
WHATSAPP_AGENT_DIAGNOSTICS_ALLOW_MUTATIONS=

# Finance sync
GOOGLE_SHEETS_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_RANGE=
FINANCE_SYNC_SECRET=