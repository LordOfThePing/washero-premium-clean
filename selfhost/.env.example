# ===== Washero self-hosted Supabase — environment ======
# Copy this file to ./selfhost/.env and fill in real values. Never commit .env.
# Generate strong secrets with:  openssl rand -hex 32

# --- Core secrets (generate fresh; don't reuse hosted keys) ---
# Signed JWT used by auth + PostgREST + storage + studio.
JWT_SECRET=REPLACE_WITH_openssl_rand_hex_32
# Public anon key (role=anon). Mint one signed with JWT_SECRET — see README.selfhost.md.
ANON_KEY=REPLACE_WITH_anon_key
# Service-role key (role=service_role). Same minting as ANON_KEY.
SERVICE_ROLE_KEY=REPLACE_WITH_service_role_key
# Realtime signing secret (any long random string).
REALTIME_SECRET=REPLACE_WITH_another_openssl_rand_hex_32

# --- Database ---
POSTGRES_PASSWORD=REPLACE_WITH_a_strong_postgres_password
POSTGRES_HOST=db
POSTGRES_PORT=5432
DB_VOLUME_MOUNT=/var/lib/postgresql/data

# --- Public URLs ---
# Public origin the tunnel exposes for API + auth callbacks (no trailing slash).
SUPABASE_PUBLIC_URL=https://api.washero.ar
# Origin GoTrue uses for links (password reset, magic links). Frontend origin.
SITE_URL=https://washero.ar
# Comma-separated allowed redirect targets for oauth/magic links.
ADDITIONAL_REDIRECT_URLS=https://washero.ar,http://localhost:3000
# Studio public origin (callback for Studio).
AUTH_ORIGIN=https://studio.washero.ar

# --- SMTP (optional; auth defaults to auto-confirm when unset) ---
SMTP_ADMIN_EMAIL=no-reply@washero.ar
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=Washero

# --- Host ports (all bound to loopback; expose only via the tunnel) ---
KONG_HTTP_PORT=8000
KONG_HTTPS_PORT=8443
STUDIO_PORT=3000
REST_PORT=3001
AUTH_PORT=9999
REALTIME_PORT=4000
STORAGE_PORT=5000
IMGPROXY_PORT=5001
META_PORT=8080
EDGE_RUNTIME_PORT=8081
POSTGRES_PORT=5432

# --- Logflare (optional; empty disables Studio logs) ---
LOGFLARE_API_KEY=
