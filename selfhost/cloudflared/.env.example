# Env for the optional cloudflared compose service (selfhost/compose.cloudflared.yaml).
# Copy to selfhost/cloudflared/.env and fill in real values. Never commit.

# Two modes (pick one):
#  1) TUNNEL_TOKEN (quick): paste the Docker token from the Zero Trust dashboard
#     - Networks -> Tunnels -> your tunnel -> Configure -> Docker -> token
#     Token mode ignores config.yml/credentials-file (ingress is set in the dashboard).
#  2) Credentials file: create the tunnel locally with 'cloudflared tunnel create washero',
#     put the generated <id>.json in selfhost/cloudflared/ as tunnel.json, and use
#     config.yml (which you copy from config.yml.example). Then set TUNNEL_CRED_FILE=tunnel.json.

TUNNEL_TOKEN=
TUNNEL_CRED_FILE=tunnel.json
