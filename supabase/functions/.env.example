# Supabase Edge Function secrets for washero-premium-clean.
#
# These are NOT read from this file at runtime — Edge Functions read them from the environment,
# which you configure with:
#   supabase secrets set KEY=value
# or via the Supabase Dashboard → Project Settings → Edge Functions → Secrets.
# This file exists purely as documentation of what must be configured and where. Never commit
# real values here.

# ---------------------------------------------------------------------------
# Core Supabase (usually auto-injected by the Supabase platform — verify before setting manually)
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# WhatsApp operator templates (Meta-approved template config, checked by
# _shared/whatsapp-operator-templates.ts)
# ---------------------------------------------------------------------------
# Comma-separated allowlist of template keys. Empty = all operator templates allowed.
WHATSAPP_CONFIGURED_TEMPLATES=
WASHI_AGENT_SECRET=
PUSH_INTERNAL_SECRET=

# ---------------------------------------------------------------------------
# WhatsApp AI agent (new — Claude-based)
# ---------------------------------------------------------------------------
# Anthropic API key for the agent's Claude tool-use loop. Required for the agent to respond at
# all — without it, whatsapp-agent-diagnostics reports anthropic_api_key_configured:false and
# runAgentTurn() fails safely into a human-handoff fallback message.
ANTHROPIC_API_KEY=
# Optional — defaults to claude-sonnet-5 if unset.
ANTHROPIC_MODEL=
# disabled (default) | shadow | canary | active — see _shared/whatsapp-agent/agent-mode.ts.
#   disabled: agent never runs, zero behavior change from before this feature existed.
#   shadow:   runs the full tool-use loop for allowlisted phones but NEVER sends a real WhatsApp
#             message or mutates a booking — dry-run only, for comparing agent behavior safely.
#   canary:   allowlisted phones get real replies and real bookings.
#   active:   ALL phones get real replies and real bookings — do not set this until canary has
#             been verified end-to-end (see the hardening report / outbound.ts's module doc).
WHATSAPP_AGENT_MODE=
# Comma-separated, any phone format (normalized internally to 549XXXXXXXXXX). Used by shadow/
# canary modes to select which phones are processed; ignored in active mode.
WHATSAPP_AGENT_TEST_PHONES=
# Shared secret the whatsapp-agent-worker function checks on its x-internal-secret header (cron/
# external scheduler auth — see supabase/optional/whatsapp_agent_worker_schedule.sql).
WHATSAPP_AGENT_WORKER_SECRET=
# Diagnostics endpoint gates (both default OFF — see whatsapp-agent-diagnostics/index.ts).
# Only set ALLOW_ANY_PHONE / ALLOW_MUTATIONS true against a non-production project.
WHATSAPP_AGENT_DIAGNOSTICS_ALLOW_ANY_PHONE=
WHATSAPP_AGENT_DIAGNOSTICS_ALLOW_MUTATIONS=

# ---------------------------------------------------------------------------
# WhatsApp tool endpoints (no-Anthropic architecture — n8n's booking agent calls these
# directly; no ANTHROPIC_API_KEY or WHATSAPP_AGENT_MODE involvement). See
# docs/n8n-whatsapp-cloudapi-cutover.md.
# ---------------------------------------------------------------------------
# Shared secret the whatsapp-tools function checks on its x-whatsapp-tools-secret header.
# Generate with `openssl rand -hex 32`; distinct from WHATSAPP_AGENT_WORKER_SECRET so the two can
# be rotated independently.
WHATSAPP_TOOLS_SECRET=

# ---------------------------------------------------------------------------
# Google
# ---------------------------------------------------------------------------
GOOGLE_MAPS_SERVER_KEY=

# ---------------------------------------------------------------------------
# MercadoPago
# ---------------------------------------------------------------------------
MERCADOPAGO_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# Web push (operator notifications)
# ---------------------------------------------------------------------------
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=

# ---------------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------------
# Production site origin used in WhatsApp links / booking confirmations.
# Set in Supabase Edge secrets: PUBLIC_SITE_URL=https://washero.ar
PUBLIC_SITE_URL=https://washero.ar
OPERATOR_ALLOW_UNASSIGNED_TODAY=

# ---------------------------------------------------------------------------
# WhatsApp outbound — routed through the n8n "WhatsApp Outbound Gateway" webhook.
# ALL Meta / WhatsApp credentials live in n8n ONLY. Supabase must NEVER hold a
# Meta access token. Lifecycle + operator messages POST to this webhook, which
# sends via n8n's own WhatsApp account credential.
# (See supabase/functions/_shared/whatsapp-automation.ts and
#  docs/n8n-whatsapp-cloudapi-cutover.md §5.2 — decision = option B.)
# ---------------------------------------------------------------------------

# Production webhook URL for the outbound gateway workflow (xLrRt4VrVGgFYwko).
# Get the CURRENT value from n8n: workflow -> Outbound Webhook node -> Production URL.
N8N_WHATSAPP_WEBHOOK_URL=https://n8n.flynnpedroa.engineer/webhook/washero-whatsapp-outbound

# Secret value the gateway webhook checks. MUST match the dedicated
# "Washero Outbound Webhook Auth" n8n httpHeaderAuth credential (NOT the shared
# whatsapp-tools credential — rotating one must not break the other).
# Generate with 'openssl rand -hex 32'.
N8N_WHATSAPP_WEBHOOK_SECRET=

# Header NAME the gateway webhook expects (default x-washero-outbound-secret).
# Only override if the n8n credential uses a different header name.
N8N_WHATSAPP_WEBHOOK_HEADER=x-washero-outbound-secret

# ---------------------------------------------------------------------------
# DEPRECATED / UNUSED — do NOT re-add these as Supabase secrets.
# These were an old direct-to-Meta path that held a Meta access token in
# Supabase. The decision is to centralize ALL Meta credentials in n8n, so these
# must stay unset. Left here (not deleted) so nobody re-adds them out of habit
# from older docs. _shared/whatsapp-outbound.ts no longer uses them.
# ---------------------------------------------------------------------------
# WHATSAPP_CLOUD_API_TOKEN=
# WHATSAPP_CLOUD_PHONE_NUMBER_ID=
# WHATSAPP_CLOUD_API_VERSION=
# WHATSAPP_CLOUD_GRAPH_BASE=
# CLOUD_TEMPLATE_NAME_<KEY>=
# CLOUD_TEMPLATE_LANGUAGE=

# ---------------------------------------------------------------------------
# MercadoPago payment skip (dev/test only — see create-website-booking/index.ts)
# ---------------------------------------------------------------------------
# WASHERO_SKIP_PAYMENT=true marks every booking payment_status=paid immediately and skips both
# the MercadoPago checkout-preference call and the Transferencia instructions flow, so the full
# booking -> WhatsApp-confirmation path can be tested with zero MercadoPago account. The
# confirmation WhatsApp fires immediately (it normally waits for payment). NEVER set this in
# production — no payment is ever actually collected while it's on.
WASHERO_SKIP_PAYMENT=

# ---------------------------------------------------------------------------
# Integration tests only (never set these against production)
# ---------------------------------------------------------------------------
WHATSAPP_AGENT_ALLOW_INTEGRATION_TESTS=
